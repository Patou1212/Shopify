DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockify?schema=public"
APP_URL="http://localhost:3000"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_SCOPES="read_products,read_inventory,write_inventory,read_locations"
APP_ENCRYPTION_KEY=""

# Activer uniquement après migration et création du premier administrateur (docs/SAAS.md)
STOCKIFY_SAAS=false

# Parcours gratuit autonome en mode SaaS (false pour fermer les inscriptions)
STOCKIFY_PUBLIC_SIGNUP=true
STOCKIFY_FREE_SHOP_LIMIT=1
